# HAM 工具合集 · 服务端配置模板
# 用法：复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，请勿提交到仓库。

# ---- HTTP 服务 ----
PORT=3000

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hamtools
DB_PASSWORD=change-me
DB_NAME=hamtools

# ---- 账号与令牌 ----
# JWT_SECRET 至少 16 位，建议用 openssl rand -hex 32 生成
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=180d
# bcrypt 计算轮数，机器慢可降到 8
BCRYPT_ROUNDS=10

# ---- 联网板块上游（均无需密钥） ----
DXWATCH_URL=https://www.dxwatch.com/dx
HAMDB_URL=https://api.hamdb.org/v1/

# ---- QSL 卡片图片存储 ----
# 不填默认 server/uploads/qsl/。需保证 Node 运行账号可写，
# 且务必不要把这个目录配置成 Nginx 可直接匿名访问的静态目录。
# QSL_UPLOAD_DIR=/var/lib/hamtools/qsl-cards

# ---- 可选：海外源代理 ----
# Node 原生 fetch 默认不读代理变量。如果服务器无法直连 dxwatch.com / hamdb.org，
# 执行 `npm i undici`，服务会自动用 undici 的 ProxyAgent 走下面这个代理。
# HTTPS_PROXY=http://127.0.0.1:7890
