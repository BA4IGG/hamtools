# 复制为 .env 后按你的实际情况修改，不要提交 .env 到仓库

# 服务监听端口
PORT=3000

# MySQL 连接信息
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hamtools
DB_PASSWORD=change_me_please
DB_NAME=hamtools

# JWT 签名密钥，务必改成一串足够长的随机字符串
# 可用 node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" 生成
JWT_SECRET=please_replace_this_with_a_long_random_string

# 令牌有效期（默认 180 天，方便手机端长期免登录）
JWT_EXPIRES_IN=180d

# bcrypt 计算轮数，机器慢可降到 8
BCRYPT_ROUNDS=10
