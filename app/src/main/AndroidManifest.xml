<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 账号注册/登录需要访问自部署的账号服务器 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      改写 Settings.System 的 min/peak_refresh_rate，把系统允许的最高刷新率抬上去。
      这个权限无法用运行时弹窗申请，只能引导用户到系统页手动打开；未授权时高刷功能自动降级。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      QSL 卡片交换：别人向我发起交换申请时发一条本地通知。
      Android 13 (API 33) 起属于运行时危险权限，只在用户进入 QSL 板块、
      看完用途说明后申请；被拒绝不影响其余功能，也不反复弹窗。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      FT8 / SSTV 解码：用户主动点「开始监听」后才申请，属于运行时危险权限。
      PCM 只在内存里做本机信号处理，不写录音文件、不上传、不联网；
      拒绝后编码、播放、本机自测与导入 WAV 解码仍然可用，离开页面即释放麦克风。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      模拟考试锁定：保持 OnBackPressedDispatcher 路径，让考试页能完整接管
      系统返回键与侧滑返回手势（弹确认框而不是直接退出）。
    -->
    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HAM工具合集"
        android:enableOnBackInvokedCallback="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HAM工具合集"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>