    <!-- 说明 -->
    <string name="note_wavelength">频段划分按 IARU/ITU 常见惯例整理，60m 与 4m 各国差异较大，请以本国现行频率划分规定为准。</string>
    <string name="note_antenna">经验公式：长度 = 波长 × 波长系数 × 0.95 端部效应系数（倒 V 额外取 0.96）。实际架设请留 2–3% 冗余后逐步修剪。</string>
    <string name="note_vswr">默认 S9 对应 -73 dBm。这里假设失配发生在单一参考面，未区分天线端与发射机端的驻波差异。</string>
    <string name="note_feedline">损耗由厂家公布数据双对数插值估算，未计入接头损耗、老化与环境温度影响。</string>
    <string name="note_link_budget">自由空间模型，未考虑地形遮挡、绕射、电离层反射与多径衰落，结果仅供参考。</string>

